{
  "name": "turbovec-ts",
  "version": "0.1.1",
  "private": true,
  "description": "TypeScript/Node.js bindings for turbovec, a 2-4 bit vector quantization and SIMD search library.",
  "keywords": [
    "ann",
    "napi",
    "quantization",
    "rust",
    "simd",
    "vector",
    "vector-search"
  ],
  "homepage": "https://github.com/KkSss999/turbovec-ts",
  "bugs": {
    "url": "https://github.com/KkSss999/turbovec-ts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KkSss999/turbovec-ts.git"
  },
  "files": [
    "*.node",
    "LICENSE",
    "LICENSE-TURBOVEC",
    "README.md",
    "errors.cjs",
    "errors.d.ts",
    "errors.js",
    "index.cjs",
    "index.d.ts",
    "index.js",
    "native.cjs",
    "native.d.ts",
    "native.js",
    "CHANGELOG.md",
    "docs/"
  ],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./errors": {
      "types": "./errors.d.ts",
      "import": "./errors.js",
      "require": "./errors.cjs"
    }
  },
  "scripts": {
    "build": "bun run build:errors && bun run build:cjs && bun run build:esm",
    "build:debug": "bun run build:errors && napi build --platform --js native.cjs --dts native.d.ts && napi build --platform --esm --js native.js --dts native.d.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "typecheck": "oxlint --type-aware --type-check --no-error-on-unmatched-pattern",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "test": "bun test tests/smoke.test.ts tests/robustness.test.ts",
    "release:check": "bun scripts/check-release.ts",
    "prepack": "bun run release:check",
    "prepublishOnly": "bun run release:check && bun run check && bun run test",
    "test:interop": "bun scripts/require-interop.ts && bun test tests/interop.test.ts",
    "build:cjs": "napi build --platform --release --js native.cjs --dts native.d.ts",
    "build:esm": "napi build --platform --release --esm --js native.js --dts native.d.ts",
    "build:errors": "bun build src/errors.ts --target node --format esm --outfile errors.js && bun build src/errors.ts --target node --format cjs --outfile errors.cjs",
    "bench": "bun run build && bun bench/wrapper.ts",
    "bench:quick": "bun bench/run.ts --shape quick",
    "bench:all": "bun bench/run.ts --shape all",
    "smoke:electron": "bun run build && cd examples/electron-app && bun run smoke"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "optionalDependencies": {
    "turbovec-ts-darwin-arm64": "0.1.1",
    "turbovec-ts-darwin-x64": "0.1.1",
    "turbovec-ts-linux-arm64-gnu": "0.1.1",
    "turbovec-ts-linux-x64-gnu": "0.1.1",
    "turbovec-ts-win32-arm64-msvc": "0.1.1",
    "turbovec-ts-win32-x64-msvc": "0.1.1"
  },
  "napi": {
    "binaryName": "turbovec-ts",
    "npmClient": "bun",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">=20.17"
  },
  "packageManager": "bun@1.4.4"
}
